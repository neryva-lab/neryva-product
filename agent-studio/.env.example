# Agent Studio — typed immutable config reference
# See docs/architecture/agent_studio/imp/ledger.md:0.10 and agent_studio_implementation_plan.md:549-615
# Secrets are references to secret manager / workload identity, never plaintext values.
# Copy to .env for local dev only. Never commit .env.

# ── Runtime ──
SERVICE_NAME=agent-studio
BUILD_VERSION=0.1.0
ENVIRONMENT=development # development | staging | production
SHUTDOWN_DEADLINE_MS=30000

# ── Temporal ──
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agent-run-default
TEMPORAL_WORKER_IDENTITY=agent-studio-worker-1
TEMPORAL_WORKFLOW_BUNDLE_PATH=./apps/runtime-worker/dist/workflow-bundle.js
TEMPORAL_PAYLOAD_CODEC_MODE=claim-check # claim-check | encrypted
TEMPORAL_RETENTION_DAYS=7

# ── Neryva MCP ──
NERYVA_MCP_ENDPOINT=http://localhost:50051
NERYVA_MCP_PROTOCOL_MAJOR=1
NERYVA_MCP_MINIMUM_MINOR=0
NERYVA_MCP_CONNECT_TIMEOUT_MS=5000
NERYVA_MCP_REQUEST_TIMEOUT_MS=30000
NERYVA_MCP_CAPABILITY_ISSUER=neryva-engine
NERYVA_MCP_CAPABILITY_KEY_ID=mcp-key-1

# ── Model Gateway ──
MODEL_GATEWAY_ENABLED_PROVIDERS=openai
MODEL_GATEWAY_CATALOG_SOURCE=engine-policy-snapshot
MODEL_GATEWAY_PROVIDER_TIMEOUT_MS=30000
MODEL_GATEWAY_CONCURRENCY_LIMIT=10
MODEL_GATEWAY_REDACTION_MODE=strict

# ── Tool Gateway ──
TOOL_GATEWAY_REGISTRY_SOURCE=contracts/tool
TOOL_GATEWAY_EFFECT_POLICY=strict
TOOL_GATEWAY_APPROVAL_POLICY=required-for-mutating
TOOL_GATEWAY_SANDBOX_ENDPOINT=http://localhost:8081
TOOL_GATEWAY_EGRESS_MODE=deny-by-default

# ── Artifacts (claim-check) ──
ARTIFACTS_CLAIM_CHECK_MODE=engine-authorized
ARTIFACTS_MAX_INLINE_BYTES=8192
ARTIFACTS_MAX_ARTIFACT_BYTES=10485760
ARTIFACTS_ALLOWED_PURPOSES=SOURCE_DOCUMENT,CHECKPOINT,TOOL_RESULT,TRANSCRIPT,EXPORT

# ── Telemetry ──
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SAMPLING_POLICY=parentbased_always_on
OTEL_CONTENT_CAPTURE_POLICY=hash-only
OTEL_METRICS_NAMESPACE=neryva_agent_studio
LOG_LEVEL=info

# ── Secret references (never values) ──
# Provider credentials via workload secret provider — e.g.:
# SECRET_PROVIDER=aws-secrets-manager
# OPENAI_API_KEY_REF=arn:aws:secretsmanager:us-east-1:123:secret:openai
# ANTHROPIC_API_KEY_REF=arn:aws:secretsmanager:us-east-1:123:secret:anthropic

# ── Runtime control (harness execution plane, 2026-09-12) ──────────────────
# Execution mode: inline (in-process executor, dev/single-node) | temporal
EXECUTION_MODE=inline
# Engine MCP authority surface (ConnectRPC on the Engine's Fastify port)
NERYVA_MCP_ENDPOINT=http://localhost:3000
# Shared Engine->Studio service token; REQUIRED (fail-closed) in production
NERYVA_SERVICE_TOKEN=
# LiteLLM proxy (ADR-009) — provider-neutral gateway over 100+ providers.
# When set, ALL provider prefixes (openai/ anthropic/ google/ litellm/) route
# through the proxy; unset falls back to built-in simulation adapters (dev).
LITELLM_BASE_URL=
LITELLM_API_KEY=
MODEL_GATEWAY__DEFAULT_MODEL=openai/gpt-4o-mini
