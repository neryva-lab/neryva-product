# pnpm workspace — Agent Studio
# Peer handling: ai (Vercel SDK) has optional react peer for @ai-sdk/react — not required for gateway core
strict-peer-dependencies=false
auto-install-peers=true
engine-strict=true
save-exact=true

# Temporal native deps need build
enable-pre-post-scripts=true

# Ensure frozen lockfile in CI
frozen-lockfile=true

# Hoisting — Phase 0 skeleton allows shameful hoist for shared deps (zod, otel, uuid) to simplify bootstrapping
# Production hardening (Phase 10) will enforce per-package deps and set shamefully-hoist=false
shamefully-hoist=true
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
