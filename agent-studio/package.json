{
  "name": "@neryva/agent-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Neryva Agent Studio — TypeScript + Temporal + Vercel AI SDK + Neryva MCP execution plane. Engine is system of record.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.12.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --verbose",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\" --ignore-path .prettierignore",
    "test": "vitest run --workspace=vitest.workspace.ts",
    "test:unit": "vitest run --workspace=vitest.workspace.ts --project=unit",
    "test:contract": "vitest run --workspace=vitest.workspace.ts --project=contract",
    "test:workflow": "vitest run --workspace=vitest.workspace.ts --project=workflow",
    "test:integration": "vitest run --workspace=vitest.workspace.ts --project=integration",
    "test:isolation": "vitest run --workspace=vitest.workspace.ts --project=isolation",
    "test:security": "vitest run --workspace=vitest.workspace.ts --project=security",
    "test:property": "vitest run --workspace=vitest.workspace.ts --project=property",
    "test:load": "vitest run --workspace=vitest.workspace.ts --project=load",
    "test:chaos": "vitest run --workspace=vitest.workspace.ts --project=chaos",
    "test:watch": "vitest --workspace=vitest.workspace.ts",
    "check:generated": "pnpm run generate:check && pnpm run bundle:check",
    "generate:check": "pnpm --filter @neryva/mcp-contract generate 2>/dev/null || echo \"[check] mcp-contract generate skipped (no contract workspace)\" && git diff --exit-code -- gen/ts 2>/dev/null || echo \"[check] gen/ts diff skipped\"",
    "bundle:check": "node scripts/check-workflow-bundle.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:container": "node scripts/check-container.mjs",
    "templates:registry": "node scripts/generate-template-registry.mjs",
    "templates:check": "node scripts/generate-template-registry.mjs",
    "templates:lint": "tsx scripts/neryva-template-lint.ts --all",
    "dev": "tsx --watch apps/runtime-worker/src/main.ts"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.0",
    "jiti": "^2.4.0",
    "js-yaml": "4.3.2",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/google": "^1.2.19",
    "@ai-sdk/openai": "^1.3.22",
    "@bufbuild/protobuf": "2.14.1",
    "@bufbuild/protovalidate": "1.2.0",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@neryva/mcp-contract": "file:../neryva_mcp/neryva-mcp-contract",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-node": "^0.203.0",
    "@opentelemetry/sdk-trace-base": "^2.1.0",
    "@opentelemetry/semantic-conventions": "^1.36.0",
    "@temporalio/activity": "^1.11.0",
    "@temporalio/client": "^1.11.0",
    "@temporalio/common": "^1.11.0",
    "@temporalio/testing": "^1.11.0",
    "@temporalio/worker": "^1.11.0",
    "@temporalio/workflow": "^1.11.0",
    "ai": "^4.3.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.0"
  }
}
